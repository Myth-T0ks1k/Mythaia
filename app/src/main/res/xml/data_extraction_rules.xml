<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+. Same exclusions as backup_rules.xml, for cloud backup and for
    device-to-device transfer alike; see that file for the reasoning.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="mitm" />
        <exclude domain="file" path="configurations.json" />
        <exclude domain="file" path="subscriptions.json" />
        <exclude domain="file" path="chains.json" />
        <exclude domain="file" path="routing.json" />
        <exclude domain="file" path="Rules.db" />
        <exclude domain="file" path="Rules.db.version" />
        <exclude domain="file" path="geoip.mmdb" />
        <exclude domain="sharedpref" path="mythaia_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mitm" />
        <exclude domain="file" path="configurations.json" />
        <exclude domain="file" path="subscriptions.json" />
        <exclude domain="file" path="chains.json" />
        <exclude domain="file" path="routing.json" />
        <exclude domain="file" path="Rules.db" />
        <exclude domain="file" path="Rules.db.version" />
        <exclude domain="file" path="geoip.mmdb" />
        <exclude domain="sharedpref" path="mythaia_settings.xml" />
    </device-transfer>
</data-extraction-rules>
