<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup (API 23-30). Server credentials, the MITM root-certificate
    private key and the trusted-certificate list stay on the device: a restore
    onto another phone would hand them to whoever holds that account. The rule
    database and the GeoIP file are regenerable bulk and only eat the quota.
-->
<full-backup-content>
    <exclude domain="file" path="mitm" />
    <exclude domain="file" path="configurations.json" />
    <exclude domain="file" path="subscriptions.json" />
    <exclude domain="file" path="chains.json" />
    <exclude domain="file" path="routing.json" />
    <exclude domain="file" path="Rules.db" />
    <exclude domain="file" path="Rules.db.version" />
    <exclude domain="file" path="geoip.mmdb" />
    <exclude domain="sharedpref" path="mythaia_settings.xml" />
</full-backup-content>
