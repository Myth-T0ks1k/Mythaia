    "Leave both empty for BBR; set both to use Brutal at that rate.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустыми для BBR; укажите оба, чтобы использовать Brutal на этой скорости."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "BBR üçin ikisini-de boş goýuň; ikisini-de dolduryň — şol tizlikde Brutal ulanylar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项留空则使用 BBR；两项都填则以该速率使用 Brutal。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر دو را خالی بگذارید تا BBR استفاده شود؛ هر دو را پر کنید تا Brutal با آن نرخ به کار رود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركهما فارغين لـ BBR؛ عبّئهما معاً لاستخدام Brutal بتلك السرعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacíos: BBR; ambos rellenos: Brutal a esa velocidad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống cả hai để dùng BBR; điền cả hai để dùng Brutal ở tốc độ đó."
          }
        },
        "my": {
