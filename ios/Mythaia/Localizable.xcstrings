    "%lld servers did not work on their last check. Remove them from this group?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld server did not work on its last check. Remove it from this group?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servers did not work on their last check. Remove them from this group?"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld сервер не прошёл последнюю проверку. Удалить его из группы?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld сервера не прошли последнюю проверку. Удалить их из группы?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld серверов не прошли последнюю проверку. Удалить их из группы?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld сервера не прошли последнюю проверку. Удалить их из группы?"
                }
              }
            }
          }
        },
        "tk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld serwer soňky barlagdan geçmedi. Toparyň içinden pozulsynmy?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld serwer soňky barlagdan geçmedi. Toparyň içinden pozulsynmy?"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 个服务器在上次检测中不可用。要从此分组中删除它们吗？"
                }
              }
            }
          }
        },
        "fa": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld سرور در آخرین بررسی کار نکرد. از این گروه حذف شود؟"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld سرور در آخرین بررسی کار نکردند. از این گروه حذف شوند؟"
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادم لم يعمل في آخر فحص. هل تريد حذفها من هذه المجموعة؟"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادم لم يعمل في آخر فحص. هل تريد حذفه من هذه المجموعة؟"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادمان لم يعملا في آخر فحص. هل تريد حذفهما من هذه المجموعة؟"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خوادم لم تعمل في آخر فحص. هل تريد حذفها من هذه المجموعة؟"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادمًا لم يعمل في آخر فحص. هل تريد حذفها من هذه المجموعة؟"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادم لم يعمل في آخر فحص. هل تريد حذفها من هذه المجموعة؟"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servidor falló en su última comprobación. ¿Eliminarlo de este grupo?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servidores fallaron en su última comprobación. ¿Eliminarlos de este grupo?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servidores fallaron en su última comprobación. ¿Eliminarlos de este grupo?"
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld máy chủ không hoạt động ở lần kiểm tra gần nhất. Xóa chúng khỏi nhóm này?"
                }
              }
            }
          }
        },
        "my": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ဆာဗာ %lld ခုသည် နောက်ဆုံးစစ်ဆေးမှုတွင် အလုပ်မလုပ်ပါ။ ဤအုပ်စုမှ ဖယ်ရှားမလား။"
                }
              }
            }
          }
        }
      }
    },
    "%lld servers repeat another server in this group. Remove the repeats?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld server repeats another server in this group. Remove it?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servers repeat another server in this group. Remove the repeats?"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld сервер повторяет другой сервер в этой группе. Удалить повторы?"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld сервера повторяют другие серверы в этой группе. Удалить повторы?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld серверов повторяют другие серверы в этой группе. Удалить повторы?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld сервера повторяют другие серверы в этой группе. Удалить повторы?"
                }
              }
            }
          }
        },
        "tk": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld serwer bu toparda başga serweri gaýtalaýar. Gaýtalananlar pozulsynmy?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld serwer bu toparda başga serwerleri gaýtalaýar. Gaýtalananlar pozulsynmy?"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "此分组中有 %lld 个服务器与其他服务器重复。要删除重复项吗？"
                }
              }
            }
          }
        },
        "fa": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld سرور در این گروه تکرار سرور دیگری است. حذف شود؟"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld سرور در این گروه تکرار سرورهای دیگرند. موارد تکراری حذف شوند؟"
                }
              }
            }
          }
        },
        "ar": {
          "variations": {
            "plural": {
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادم يكرر خوادم أخرى في هذه المجموعة. هل تريد حذف المكررات؟"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادم يكرر خادمًا آخر في هذه المجموعة. هل تريد حذفه؟"
                }
              },
              "two": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادمان يكرران خوادم أخرى في هذه المجموعة. هل تريد حذفهما؟"
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خوادم تكرر خوادم أخرى في هذه المجموعة. هل تريد حذف المكررات؟"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادمًا يكرر خوادم أخرى في هذه المجموعة. هل تريد حذف المكررات؟"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "‏%lld خادم يكرر خوادم أخرى في هذه المجموعة. هل تريد حذف المكررات؟"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servidor repite otro servidor de este grupo. ¿Eliminarlo?"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servidores repiten otros servidores de este grupo. ¿Eliminar las repeticiones?"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld servidores repiten otros servidores de este grupo. ¿Eliminar las repeticiones?"
                }
              }
            }
          }
        },
        "vi": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld máy chủ trùng với máy chủ khác trong nhóm này. Xóa các bản trùng?"
                }
              }
            }
          }
        },
        "my": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ဤအုပ်စုတွင် ဆာဗာ %lld ခုသည် အခြားဆာဗာကို ထပ်နေပါသည်။ ထပ်နေသည်များကို ဖယ်ရှားမလား။"
                }
              }
            }
          }
        }
      }
    },
    "A build without the Network Extension entitlement (unsigned, or running in the simulator) cannot create one; the request may also have been declined.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборка без разрешения Network Extension (неподписанная или запущенная в симуляторе) не может её создать; также запрос мог быть отклонён."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Network Extension rugsady bolmadyk gurluş (gol çekilmedik ýa-da simulýatorda işleýän) ony döredip bilmeýär; haýyşyň ret edilen bolmagy hem mümkin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有 Network Extension 权限的版本（未签名或在模拟器中运行）无法创建配置；也可能是请求被拒绝了。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخه‌ای که مجوز Network Extension ندارد (امضانشده یا در حال اجرا در شبیه‌ساز) نمی‌تواند آن را بسازد؛ ممکن است درخواست هم رد شده باشد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لنسخة بلا صلاحية Network Extension (غير موقّعة أو تعمل في المحاكي) إنشاؤه؛ وربما رُفض الطلب أيضًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compilación sin el permiso Network Extension (sin firmar o en el simulador) no puede crearla; también es posible que se rechazara la solicitud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng không có quyền Network Extension (chưa ký hoặc chạy trong trình mô phỏng) không thể tạo cấu hình; cũng có thể yêu cầu đã bị từ chối."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Network Extension ခွင့်ပြုချက်မပါသော build (လက်မှတ်မထိုးထားသော သို့မဟုတ် simulator တွင် လည်ပတ်နေသော) သည် ၎င်းကို မဖန်တီးနိုင်ပါ။ တောင်းဆိုမှုကို ငြင်းပယ်ထားခြင်းလည်း ဖြစ်နိုင်ပါသည်။"
          }
        }
      }
    },
