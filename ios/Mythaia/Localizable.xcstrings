    "Fronting can also come in the link itself: add #front=1.2.3.4&sni=example.org to the URL, or open a mythaia://import link.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фронтинг можно передать прямо в ссылке: допишите к ней #front=1.2.3.4&sni=example.org или откройте ссылку mythaia://import."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronting baglanyşygyň özünde hem berlip bilner: URL-e #front=1.2.3.4&sni=example.org goşuň ýa-da mythaia://import baglanyşygyny açyň."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "域前置也可以直接写在链接里：在 URL 后加上 #front=1.2.3.4&sni=example.org，或打开 mythaia://import 链接。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرانتینگ را می‌توان در خود لینک هم گذاشت: ‎#front=1.2.3.4&sni=example.org را به آدرس اضافه کنید یا یک لینک mythaia://import باز کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن وضع التخفي في الرابط نفسه: أضف ‎#front=1.2.3.4&sni=example.org إلى العنوان أو افتح رابط mythaia://import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El fronting también puede ir en el propio enlace: añade #front=1.2.3.4&sni=example.org a la URL o abre un enlace mythaia://import."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronting cũng có thể nằm ngay trong liên kết: thêm #front=1.2.3.4&sni=example.org vào URL hoặc mở liên kết mythaia://import."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "Fronting ကို လင့်ခ်ထဲတွင်လည်း ထည့်နိုင်သည်- URL နောက်တွင် #front=1.2.3.4&sni=example.org ထည့်ပါ သို့မဟုတ် mythaia://import လင့်ခ်ကို ဖွင့်ပါ။"
          }
        }
      }
    },
