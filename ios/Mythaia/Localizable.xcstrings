    "Only the name and address of a %@ server can be changed here. Import the link again to change anything else.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сервера %1$@ здесь можно изменить только имя и адрес. Чтобы изменить остальное, импортируйте ссылку заново."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ýerde %1$@ serweriniň diňe adyny we salgysyny üýtgedip bolýar. Başga zady üýtgetmek üçin baglanyşygy täzeden import ediň."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处只能修改 %1$@ 服务器的名称和地址。如需修改其他设置，请重新导入链接。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در اینجا فقط نام و نشانی سرور %1$@ را می‌توان تغییر داد. برای تغییر موارد دیگر، لینک را دوباره وارد کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن هنا تغيير اسم وعنوان خادم %1$@ فقط. أعد استيراد الرابط لتغيير أي شيء آخر."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí solo se pueden cambiar el nombre y la dirección de un servidor %1$@. Vuelve a importar el enlace para cambiar lo demás."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở đây chỉ có thể thay đổi tên và địa chỉ của máy chủ %1$@. Nhập lại liên kết để thay đổi các mục khác."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ဆာဗာ၏ အမည်နှင့် လိပ်စာကိုသာ ဤနေရာတွင် ပြောင်းနိုင်သည်။ အခြားအရာများ ပြောင်းရန် လင့်ခ်ကို ပြန်ထည့်သွင်းပါ။"
          }
        }
      }
    },
