    "Routing, theme and latency test go back to their defaults. Servers and subscriptions stay.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрутизация, тема и проверка задержки вернутся к значениям по умолчанию. Серверы и подписки останутся."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugratma, tema we gijikdirme barlagy adaty ýagdaýyna gaýdýar. Serwerler we abunalar galýar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路由、主题和延迟测试将恢复默认值。服务器和订阅会保留。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیریابی، پوسته و آزمایش تأخیر به حالت پیش‌فرض برمی‌گردند. سرورها و اشتراک‌ها می‌مانند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعود إعدادات التوجيه والمظهر واختبار زمن الاستجابة إلى قيمها الافتراضية. وتبقى الخوادم والاشتراكات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enrutamiento, el tema y la prueba de latencia vuelven a sus valores predeterminados. Los servidores y las suscripciones se conservan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định tuyến, giao diện và kiểm tra độ trễ sẽ trở về mặc định. Máy chủ và gói đăng ký được giữ lại."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "routing၊ theme နှင့် latency စမ်းသပ်မှုတို့ မူလအတိုင်း ပြန်ဖြစ်သွားပါမည်။ ဆာဗာများနှင့် စာရင်းသွင်းမှုများ ကျန်ရှိပါမည်။"
          }
        }
      }
