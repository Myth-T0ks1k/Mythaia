    "Updates run while the app is open: each time it opens, or once the interval has passed.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления выполняются, пока приложение открыто: при каждом открытии или когда прошёл интервал."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Täzelenmeler programma açyk wagty geçirilýär: her açylanda ýa-da aralyk geçenden soň."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新在应用打开时进行：每次打开时，或间隔时间已过时。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی‌ها وقتی برنامه باز است انجام می‌شوند: هر بار که باز می‌شود، یا وقتی فاصله زمانی گذشته باشد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجري التحديثات والتطبيق مفتوح: عند كل فتح، أو بعد انقضاء الفاصل الزمني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones se hacen con la app abierta: cada vez que se abre o cuando ha pasado el intervalo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật chạy khi ứng dụng đang mở: mỗi lần mở, hoặc khi đã qua khoảng thời gian."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "အပ်ဒိတ်များကို အက်ပ်ဖွင့်ထားစဉ် လုပ်ဆောင်ပါသည် — ဖွင့်တိုင်း သို့မဟုတ် ကြားကာလ ကျော်လွန်သည့်အခါ။"
          }
        }
      }
    },
