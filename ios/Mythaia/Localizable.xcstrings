          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي الاشتراك على خوادم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción no tiene servidores."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
