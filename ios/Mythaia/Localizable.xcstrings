    "Applies to every server: no certificate is checked anywhere, except on servers with a pinned certificate (pcs).": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действует на все серверы: сертификаты не проверяются нигде, кроме серверов с закреплённым сертификатом (pcs)."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ähli serwerler üçin: berkidilen sertifikatly (pcs) serwerlerden başga hiç ýerde sertifikat barlanmaýar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所有服务器生效：除设置了固定证书（pcs）的服务器外，不验证任何证书。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای همه سرورها اعمال می‌شود: هیچ گواهی‌ای بررسی نمی‌شود، به‌جز سرورهایی که گواهی سنجاق‌شده (pcs) دارند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على كل الخوادم: لا يتم التحقق من أي شهادة، باستثناء الخوادم ذات الشهادة المثبتة (pcs)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a todos los servidores: no se comprueba ningún certificado, salvo en los servidores con un certificado fijado (pcs)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Áp dụng cho mọi máy chủ: không kiểm tra chứng chỉ nào, trừ các máy chủ có chứng chỉ được ghim (pcs)."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆာဗာအားလုံးအတွက် သက်ရောက်သည် — ချိတ်ထားသော လက်မှတ် (pcs) ရှိသည့် ဆာဗာများမှအပ မည်သည့်လက်မှတ်ကိုမျှ စစ်ဆေးမည်မဟုတ်ပါ။"
          }
        }
      }
    },
