    "Trusts exactly this certificate, even self-signed. Separate several with commas.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доверять ровно этому сертификату, даже самоподписанному. Несколько — через запятую."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Diňe şu sertifikata ynanýar, hatda öz-özüne gol çekilen bolsa-da. Birnäçesini otur bilen aýyryň."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只信任这一证书，自签名也可以。多个用逗号分隔。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دقیقاً به همین گواهی اعتماد می‌کند، حتی اگر خودامضا باشد. چند مقدار را با ویرگول جدا کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثق بهذه الشهادة تحديدًا، حتى لو كانت موقعة ذاتيًا. افصل بين عدة قيم بفواصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confía exactamente en este certificado, aunque sea autofirmado. Separa varios con comas."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tin đúng chứng chỉ này, kể cả tự ký. Ngăn cách nhiều giá trị bằng dấu phẩy."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဤလက်မှတ်ကိုသာ ယုံကြည်သည်၊ ကိုယ်တိုင်လက်မှတ်ထိုးထားလျှင်ပင်။ အများကို ကော်မာဖြင့် ခွဲပါ။"
          }
        }
      }
    },
