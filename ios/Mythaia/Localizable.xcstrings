    "Camera access is blocked. Allow it in the app settings to scan QR codes.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере запрещён. Разрешите его в настройках приложения, чтобы сканировать QR-коды."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera girişi ýapyk. QR kodlary skanirlemek üçin programma sazlamalarynda rugsat beriň."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限已被禁止。请在应用设置中允许，以便扫描二维码。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به دوربین مسدود است. برای اسکن کد QR آن را در تنظیمات برنامه مجاز کنید."
          }
        },
        "ar": {
