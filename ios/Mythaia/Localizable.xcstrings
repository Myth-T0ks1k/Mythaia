    "Invalid fingerprint. Must be a 64-character hex string, or it already exists.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недопустимый отпечаток. Должен быть шестнадцатеричной строкой из 64 символов или он уже существует."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Nädogry barmak yzy. 64 belgili on alty sanly setir bolmaly ýa-da eýýäm bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指纹无效。必须是 64 个字符的十六进制字符串，或者该指纹已存在。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اثر انگشت نامعتبر است. باید یک رشته هگزادسیمال ۶۴ کاراکتری باشد، یا قبلاً وجود دارد."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بصمة غير صالحة. يجب أن تكون سلسلة سداسية عشرية مكونة من 64 حرفًا، أو أنها موجودة بالفعل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Huella digital no válida. Debe ser una cadena hexadecimal de 64 caracteres, o ya existe."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vân tay không hợp lệ. Phải là chuỗi hex 64 ký tự, hoặc nó đã tồn tại."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "လက်ဗွေ မမှန်ကန်ပါ။ hex စာလုံး ၆၄ လုံးပါ စာတန်းဖြစ်ရမည်၊ သို့မဟုတ် ၎င်းသည် ရှိပြီးသားဖြစ်သည်။"
          }
        }
      }
    },
