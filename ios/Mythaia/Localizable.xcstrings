{
  "sourceLanguage": "en",
  "strings": {
    "%@ and all of its servers (%lld) will be removed.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ и все его серверы (%2$lld) будут удалены."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ we onuň ähli serwerleri (%2$lld) aýrylar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除 %1$@ 及其全部服务器（%2$lld）。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ و همه سرورهای آن (%2$lld) حذف می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف %1$@ وخوادمه (%2$lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará %1$@ y todos sus servidores (%2$lld)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ và tất cả máy chủ của nó (%2$lld) sẽ bị xóa."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ နှင့် ၎င်း၏ ဆာဗာအားလုံး (%2$lld) ကို ဖယ်ရှားပါမည်။"
          }
        }
      }
    },
    "%@ of %@": {
