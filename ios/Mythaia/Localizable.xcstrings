    "What a server's latency measures by default. Auto always ranks servers by real ping.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что по умолчанию измеряет задержка сервера. Авто всегда ранжирует серверы по настоящему пингу."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Serweriň gijikdirmesiniň adatça näme ölçeýändigi. Awto serwerleri hemişe hakyky ping boýunça tertipleýär."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认测量服务器延迟的方式。自动模式始终按真实延迟对服务器排序。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آنچه تأخیر سرور به‌طور پیش‌فرض می‌سنجد. حالت خودکار همیشه سرورها را بر اساس پینگ واقعی رتبه‌بندی می‌کند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يقيسه زمن استجابة الخادم افتراضيًا. يرتّب الوضع التلقائي الخوادم دائمًا حسب الـ ping الحقيقي."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que mide por defecto la latencia de un servidor. Auto siempre ordena los servidores por ping real."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Độ trễ máy chủ đo gì theo mặc định. Chế độ Tự động luôn xếp hạng máy chủ theo ping thật."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ဆာဗာ latency သည် မူလအားဖြင့် ဘာကို တိုင်းတာသည်။ Auto သည် ဆာဗာများကို တကယ့် ping အလိုက် အမြဲ အဆင့်သတ်မှတ်သည်။"
          }
        }
      }
    },
