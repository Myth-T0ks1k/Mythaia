    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used only to read QR codes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера используется только для чтения QR-кодов."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera diňe QR kodlary okamak üçin ulanylýar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机仅用于读取二维码。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوربین فقط برای خواندن کد QR استفاده می‌شود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الكاميرا لقراءة رموز QR فقط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo se usa para leer códigos QR."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy ảnh chỉ được dùng để đọc mã QR."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ကင်မရာကို QR ကုဒ်ဖတ်ရန်သာ အသုံးပြုသည်။"
          }
        }
      }
