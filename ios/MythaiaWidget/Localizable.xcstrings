    "Connection status, and one tap to connect or disconnect.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Состояние подключения и одно нажатие, чтобы подключиться или отключиться."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "Birikme ýagdaýy we birikmek ýa-da kesmek üçin bir basyş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接状态，一点即可连接或断开。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت اتصال، و یک ضربه برای وصل یا قطع کردن."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة الاتصال، وضغطة واحدة للاتصال أو قطعه."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de la conexión, y un toque para conectar o desconectar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái kết nối, và một chạm để kết nối hoặc ngắt."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "ချိတ်ဆက်မှုအခြေအနေနှင့် ချိတ်ဆက်ရန် သို့မဟုတ် ဖြတ်တောက်ရန် တစ်ချက်တို့ရုံဖြင့်။"
          }
        }
      }
    },
