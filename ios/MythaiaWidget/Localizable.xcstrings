    "Open Mythaia Pro once to set up the VPN.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Mythaia Pro один раз, чтобы настроить VPN."
          }
        },
        "tk": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN-i sazlamak üçin Mythaia Pro-ny bir gezek açyň."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一次 Mythaia Pro 以设置 VPN。"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای راه‌اندازی VPN یک بار Mythaia Pro را باز کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Mythaia Pro مرة واحدة لإعداد الـ VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Mythaia Pro una vez para configurar la VPN."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Mythaia Pro một lần để thiết lập VPN."
          }
        },
        "my": {
          "stringUnit": {
            "state": "translated",
            "value": "VPN ကို စီစဉ်ရန် Mythaia Pro ကို တစ်ကြိမ် ဖွင့်ပါ။"
          }
        }
      }
    },
